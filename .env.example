# ── Backend Environment Variables ────────────────────────────────────────────
# Railway'de bu değerleri "Variables" sekmesine ekle

# JWT — güçlü, rastgele bir string gir (örn: openssl rand -hex 32)
JWT_SECRET_KEY=degistir-bunu-guclu-bir-secret-yap

# JWT token geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL — Railway otomatik sağlar (değiştirme)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# BERT'i devre dışı bırak (free tier için true yap)
DISABLE_BERT=true

# CORS — Frontend Railway URL'ini ekle (örn: https://frontend-xxx.railway.app)
ALLOWED_ORIGINS=https://frontend-xxx.railway.app

# SerpAPI anahtarı (Google Maps arama için)
SERPAPI_API_KEY=senin-serpapi-anahtarin

# ── Frontend Environment Variables ───────────────────────────────────────────
# Frontend Railway servisinin "Variables" sekmesine ekle

# Backend Railway URL'i (örn: https://backend-xxx.railway.app)
VITE_API_URL=https://backend-xxx.railway.app
